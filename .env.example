# Dirección ORIGEN de Django, sin /api al final. Recarga la app al cambiarla.
# Teléfono físico en la misma red: usa la IP actual de tu PC.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
# Navegador en tu PC: abre Expo en http://localhost:8081.
EXPO_PUBLIC_API_URL_WEB=http://localhost:8000
# Android Emulator (para teléfono físico elimina esta variable y usa la IP LAN).
EXPO_PUBLIC_API_URL_ANDROID=http://10.0.2.2:8000
# Para un backend publicado, usa su URL HTTPS y elimina las dos excepciones locales.
# Nunca agregues credenciales de PostgreSQL ni DATABASE_URL a Expo.
# RESEND_API_KEY y el remitente se configuran en backend/servidor/.env,
# junto con la vigencia de recuperación. No son variables públicas de Expo.
# Docker compila con true para usar el dominio actual del navegador y /api.
# Mantén false en desarrollo si Django y Expo escuchan en puertos separados.
EXPO_PUBLIC_API_SAME_ORIGIN=false
